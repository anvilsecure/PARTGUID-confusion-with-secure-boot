# Make the boot deterministic for the lab.
#
# qemu_arm64 defaults to BOOTSTD (`bootcmd = "bootflow scan -lb"`), which picks a
# bootflow heuristically. Instead we SCAN the virtio disks in order for a boot.scr and
# source the first one found, recording which device it came from in ${bootdev}. This
# models a device that boots from whichever attached medium carries the boot payload:
#   - single disk / internal media -> boot.scr found on virtio 0 (bootdev=0)
#   - device + attacker USB: the USB (virtio 0) has no boot slot, so U-Boot falls
#     through to the internal disk on virtio 1 (bootdev=1) — realistic router behaviour.
# boot.scr then verifies the rootfs and loads the kernel from ${bootdev}.
# CONFIG_BOOTSTD_BOOTCOMMAND is not set
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="virtio scan; setenv bootdev 0; ext4load virtio 0:2 ${scriptaddr} /boot.scr && source ${scriptaddr}; setenv bootdev 1; ext4load virtio 1:2 ${scriptaddr} /boot.scr && source ${scriptaddr}"

# `hash` command so boot.cmd can verify the rootfs it finds BY NAME (models the
# vendor's verify_image step). CONFIG_SHA256 is already in the defconfig.
CONFIG_CMD_HASH=y
CONFIG_HASH=y
