# Stage B: real FIT-signature verified boot on qemu_arm64.
#
# The qemu_arm64 defconfig takes its control FDT from QEMU at runtime (OF_BOARD),
# so the verifying public key has nowhere to live. We disable OF_BOARD and force
# U-Boot to use its OWN embedded control FDT (a copy of QEMU's virt DTB, into which
# mkimage -K stamps the pubkey). scripts/of_allowlist.txt must list `qemu-arm` or
# scripts/check-of.sh fails the build (see build-uboot-stageb.sh).
# CONFIG_OF_BOARD is not set
# CONFIG_OF_OMIT_DTB is not set
CONFIG_OF_SEPARATE=y
CONFIG_DEFAULT_DEVICE_TREE="qemu-arm64"

# Enforced verified boot: refuse unsigned/legacy fallback so a tampered FIT cannot
# be booted as a raw/legacy image.
CONFIG_FIT=y
CONFIG_FIT_SIGNATURE=y
CONFIG_FIT_FULL_CHECK=y
CONFIG_RSA=y
CONFIG_SHA256=y
# CONFIG_LEGACY_IMAGE_FORMAT is not set

# Deterministic boot: load the SIGNED FIT from the fixed golden slot and bootm it.
# partguid.verified tells the rootfs banner a real verification happened this boot.
# Source boot.scr from the golden slot so the Stage-B boot logic (load+bootm of the
# SIGNED FIT) lives in uboot/boot-stageb.cmd and can be iterated via a fast image
# rebuild rather than a full U-Boot rebuild. bootm still cryptographically enforces
# the FIT signature using the key embedded in this U-Boot's control DTB.
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="virtio scan; ext4load virtio 0:2 ${scriptaddr} /boot.scr && source ${scriptaddr}"
