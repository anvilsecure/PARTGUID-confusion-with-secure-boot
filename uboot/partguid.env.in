bootdelay=-2
console=ttyAMA0
kernel_addr_r=0x40400000
fit_addr=0x44000000
rootbuf_addr=0x48000000

bootname=@@BOOTNAME@@
rootname=@@ROOTNAME@@
goodhash=@@GOODHASH@@
fitfile=/kernel.itb

banner=
  echo "==================================================================";
  echo " U-Boot booted from virtio ${bootdev} (the medium carrying the boot slot)";
  part list virtio ${bootdev}

load_kernel=
  echo " --- load_kernel (signed FIT ${fitfile} from boot slot ${bootname} on virtio ${bootdev}) ---";
  setenv bootpart;
  part number virtio ${bootdev} ${bootname} bootpart;
  test -n "${bootpart}" &&
  echo " U-Boot: boot slot name ${bootname} -> virtio ${bootdev}:${bootpart}" &&
  ext4load virtio ${bootdev}:${bootpart} ${fit_addr} ${fitfile}

verify_rootfs=
  echo " --- verify_image: hash the WHOLE partition named ${rootname} on virtio ${bootdev} ---";
  setenv rootpart;
  part number virtio ${bootdev} ${rootname} rootpart;
  if test -z "${rootpart}"; then
  echo " U-Boot: no partition named ${rootname} on virtio ${bootdev} -> refusing to boot";
  reset;
  fi;
  part start virtio ${bootdev} ${rootpart} rootstart;
  part size virtio ${bootdev} ${rootpart} rootblocks;
  setexpr rootbytes ${rootblocks} * 0x200;
  virtio device ${bootdev};
  virtio read ${rootbuf_addr} ${rootstart} ${rootblocks};
  hash sha256 ${rootbuf_addr} ${rootbytes} vhash;
  echo " U-Boot: rootfs(name=${rootname}, virtio ${bootdev}:${rootpart}) sha256 = ${vhash}";
  if test "${vhash}" = "${goodhash}"; then
  echo " U-Boot: ROOTFS VERIFIED OK -> U-Boot TRUSTS ${rootname} on virtio ${bootdev}:${rootpart}";
  else
  echo " U-Boot: ROOTFS VERIFICATION FAILED -> refusing to boot";
  reset;
  fi

setup_bootargs=
  @@ROOTSPEC@@
  echo " --- setup_bootargs: Linux will locate root BY ${rootspec} ---";
  setenv bootargs "console=${console} root=${rootspec} rootfstype=ext4 rootwait rw init=/sbin/init panic=-1 partguid.verified";
  echo " NOTE: Linux re-resolves ${rootspec} independently -- watch which vdaN it mounts.";
  echo "=================================================================="

boot_slot=
  run banner;
  if run load_kernel; then
  run verify_rootfs;
  run setup_bootargs;
  echo " --- bootm: verifying the FIT signature on ${fitfile} ---";
  bootm ${fit_addr}#conf-1 - ${fdtcontroladdr};
  echo " U-Boot: ERROR bootm returned -- FIT signature check or boot failed on virtio ${bootdev}";
  else
  echo " U-Boot: no signed ${fitfile} in slot ${bootname} on virtio ${bootdev} -- trying next slot";
  fi

bootcmd=
  virtio scan;
  setenv bootdev 0; run boot_slot;
  setenv bootdev 1; run boot_slot;
  echo " U-Boot: no bootable+verified slot found -- resetting";
  reset
